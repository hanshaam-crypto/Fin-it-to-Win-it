
module Fish_Sprite(
    input [10:0] pixel_x,
    input [9:0] pixel_y,
    input [10:0] fish_x,
    input [9:0] fish_y,
    input [2:0] fish_type,

    output reg opaque,
    output reg [7:0] red,
    output reg [7:0] green,
    output reg [7:0] blue
);

    reg [4:0] sprite_col;
    reg [3:0] sprite_row;
    reg [3:0] row_start;
    reg [3:0] row_end;

    always @(*) begin
        opaque = 0;
        red = 0;
        green = 0;
        blue = 0;

        sprite_col = 0;
        sprite_row = 0;
        row_start = 0;
        row_end = 0;

        if ((pixel_x >= fish_x) &&
            (pixel_x < fish_x + 48) &&
            (pixel_y >= fish_y) &&
            (pixel_y < fish_y + 24)) begin

            sprite_col = (pixel_x - fish_x) / 3;
            sprite_row = (pixel_y - fish_y) / 3;

            // Shape of the fish.

            case (sprite_row)
                0: begin row_start = 6; row_end = 9; end
                1: begin row_start = 2; row_end = 11; end
                2: begin row_start = 1; row_end = 13; end
                3: begin row_start = 0; row_end = 14; end
                4: begin row_start = 0; row_end = 14; end
                5: begin row_start = 1; row_end = 13; end
                6: begin row_start = 2; row_end = 11; end
                7: begin row_start = 6; row_end = 9; end
                default: begin row_start = 0; row_end = 0; end
            endcase

            if ((sprite_col >= row_start) &&
                (sprite_col <= row_end)) begin

                opaque = 1;

                // Black eye.
                if ((sprite_col == 12) && (sprite_row == 3)) begin
                    red = 0;
                    green = 0;
                    blue = 0;
                end

                // Outer outline.
                else if ((sprite_col == row_start) ||
                         (sprite_col == row_end)) begin

                    case (fish_type)
                        0: begin red=30; green=30; blue=60; end
                        1: begin red=70; green=70; blue=30; end
                        2: begin red=120; green=90; blue=0; end
                        3: begin red=80; green=10; blue=10; end
                        4: begin red=120; green=60; blue=0; end
                        5: begin red=50; green=20; blue=70; end
                        default: begin red=30; green=30; blue=60; end
                    endcase
                end

                // Fish body.
                else begin
                    case (fish_type)
                        0: begin red=140; green=150; blue=170; end
                        1: begin red=200; green=195; blue=120; end
                        2: begin red=250; green=220; blue=60; end
                        3: begin red=230; green=70; blue=60; end
                        4: begin red=240; green=150; blue=60; end
                        5: begin red=130; green=70; blue=160; end
                        default: begin red=140; green=150; blue=170; end
                    endcase
                end
            end
        end
    end

endmodule
